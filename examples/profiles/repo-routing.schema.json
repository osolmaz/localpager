{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics_of_interest", "description", "caveats"],
  "properties": {
    "topics_of_interest": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "bug",
          "feature_request",
          "docs",
          "tests_ci",
          "build_release",
          "developer_experience",
          "api_contract",
          "integrations",
          "security",
          "performance"
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "caveats": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    }
  }
}
