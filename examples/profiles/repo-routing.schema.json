{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics_of_interest", "description", "caveats"],
  "properties": {
    "topics_of_interest": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "local_models",
          "model_serving",
          "runtime_reliability",
          "repo_infrastructure",
          "developer_tools",
          "tests_ci",
          "api_surface",
          "integrations",
          "security",
          "docs"
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "caveats": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    }
  }
}
