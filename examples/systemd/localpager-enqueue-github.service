[Unit]
Description=Localpager GitHub enqueue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/localpager/localpager.env
EnvironmentFile=-%h/.config/localpager/secrets.env
WorkingDirectory=%h/repos/localpager
ExecStart=%h/.local/bin/localpager-enqueue-github --config %h/.config/localpager/config.json
TimeoutStartSec=10m

[Install]
WantedBy=default.target
