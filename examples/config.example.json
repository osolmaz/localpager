{
  "repo": "owner/repo",
  "db": "~/.local/state/localpager/localpager.sqlite",
  "gitcrawl_db": "~/.config/gitcrawl/gitcrawl.db",
  "github_base_url": "https://api.github.com",
  "github_token_env": "GITHUB_TOKEN",
  "source_type": "both",
  "processor_name": "github_interest_classifier",
  "processor_version": "v1",
  "recent_window": "48h",
  "enqueue": {
    "limit": 0,
    "initial_hydration": false
  },
  "watch": {
    "sources": ["github"],
    "interval": "1m",
    "limit": 100
  },
  "classifier": {
    "schema": "./schemas/classification.schema.json",
    "prompt_template": "./prompts/github-relevance-classifier.md",
    "topic_taxonomy": "./examples/profiles/maintainer-topics.example.json",
    "context": {
      "github": {
        "include_body": true,
        "include_labels": true,
        "include_comments": true,
        "include_changed_files": true,
        "include_diff": true,
        "max_body_chars": 2500,
        "max_comments_chars": 1500,
        "max_changed_files_chars": 2000,
        "max_diff_chars": 5000
      }
    }
  },
  "worker": {
    "max_concurrency": 2,
    "lease_ttl": "30m",
    "max_attempts": 3,
    "classifier_command": "./scripts/localpager-classifier",
    "model": "gemma-4-e4b-it",
    "discord_channel_id_env": "DISCORD_CHANNEL_ID",
    "discord_token_env": "DISCORD_BOT_TOKEN",
    "send_discord": false,
    "dry_run_discord": true,
    "notify_topics_any": [],
    "poll_interval": "30s"
  }
}
