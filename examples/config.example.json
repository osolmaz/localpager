{
  "repo": "owner/repo",
  "db": "~/.local/state/localpager/localpager.sqlite",
  "gitcrawl_db": "~/.config/gitcrawl/gitcrawl.db",
  "github_base_url": "https://api.github.com",
  "github_token_env": "GITHUB_TOKEN",
  "source_type": "both",
  "processor_name": "github_interest_classifier",
  "processor_version": "v1",
  "recent_window": "48h",
  "enqueue": {
    "limit": 0,
    "initial_hydration": false
  },
  "watch": {
    "sources": ["github"],
    "interval": "1m",
    "limit": 100
  },
  "classifier": {
    "schema": "./schemas/classification.schema.json",
    "prompt_template": "./prompts/github-relevance-classifier.md",
    "topic_taxonomy": "./examples/profiles/openclaw-routing-topics.json",
    "tools": ["bash", "final_json"],
    "repo_reader_default_repo": "localpager",
    "repo_reader_visible_repos": ["localpager"],
    "context": {
      "github": {
        "include_body": true,
        "include_labels": true,
        "include_comments": true,
        "include_changed_files": true,
        "include_diff": true,
        "max_body_chars": 1200,
        "max_comments_chars": 400,
        "max_changed_files_chars": 800,
        "max_diff_chars": 1200
      }
    }
  },
  "repo_reader": {
    "enabled": true,
    "root": "~/.local/state/localpager/repo-reader",
    "socket": "~/.local/state/localpager/repo-reader.sock",
    "refresh_interval": "24h",
    "command_timeout": "2s",
    "max_output_bytes": 65536,
    "repos": [
      {
        "id": "localpager",
        "remote": "https://github.com/osolmaz/localpager.git",
        "default_ref": "origin/main",
        "refresh_interval": "24h"
      }
    ]
  },
  "worker": {
    "max_concurrency": 1,
    "lease_ttl": "30m",
    "max_attempts": 3,
    "classifier_command": "./scripts/localpager-classifier",
    "model": "gemma-4-e4b-it",
    "agent_base_url": "http://127.0.0.1:1234/v1",
    "agent_context_window": 8192,
    "agent_max_tokens": 768,
    "agent_timeout_ms": 5000,
    "model_unavailable_retry_delay": "5m",
    "discord_channel_id_env": "DISCORD_CHANNEL_ID",
    "discord_token_env": "DISCORD_BOT_TOKEN",
    "send_discord": false,
    "dry_run_discord": true,
    "notify_topics_any": [],
    "poll_interval": "30s"
  }
}
