# vLLM profile for serving Gemma-4-26B-A4B-NVFP4 to LocalPager.
# Copy this to ~/.config/localpager/vllm-gemma4-26b-a4b-nvfp4.env and edit
# paths as needed for the local vLLM install.

VLLM_WORKDIR="${HOME}/scratch/vllm-gemma4-26b-a4b-nvfp4"
VLLM_VENV="${VLLM_WORKDIR}/.venv"
VLLM_MODEL="nvidia/Gemma-4-26B-A4B-NVFP4"
VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"

# Runtime environment used by the current cu130/nightly setup on GB10.
FLASHINFER_DISABLE_VERSION_CHECK="1"
CUTE_DSL_ARCH="sm_121a"

# High-throughput text-only LocalPager profile. LocalPager classification does
# not use multimodal inputs, so serve Gemma 4 without image/video support.
VLLM_GPU_MEMORY_UTILIZATION="0.65"
VLLM_MAX_MODEL_LEN="8192"
VLLM_MAX_NUM_SEQS="32"
VLLM_MAX_NUM_BATCHED_TOKENS="8192"
VLLM_LANGUAGE_MODEL_ONLY="1"
VLLM_SKIP_MM_PROFILING="0"

# NVIDIA's Gemma 4 NVFP4 model card recommends the Gemma-specific parsers.
VLLM_REASONING_PARSER="gemma4"
VLLM_TOOL_CALL_PARSER="gemma4"

# The checkpoint carries ModelOpt metadata; vLLM detects it from config.
VLLM_QUANTIZATION=""
VLLM_KV_CACHE_DTYPE="fp8"
VLLM_MM_PROCESSOR_CACHE_GB="0"
VLLM_ENFORCE_EAGER="0"
VLLM_MOE_BACKEND="cutlass"
VLLM_DISABLE_FLASHINFER_AUTOTUNE="1"
