# vLLM profile for serving Qwen3.6-35B-A3B-NVFP4 to LocalPager.
# Copy this to ~/.config/localpager/vllm-qwen36-nvfp4.env and edit paths as
# needed for the local vLLM install.

VLLM_WORKDIR="${HOME}/scratch/vllm-qwen36-nvfp4"
VLLM_VENV="${VLLM_WORKDIR}/.venv"
VLLM_MODEL="nvidia/Qwen3.6-35B-A3B-NVFP4"
VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"

# Runtime environment used by the current cu130/nightly setup on GB10.
FLASHINFER_DISABLE_VERSION_CHECK="1"
CUTE_DSL_ARCH="sm_121a"

# Memory-bounded c4 serving profile. Keep LocalPager worker.max_concurrency at
# or below VLLM_MAX_NUM_SEQS unless deliberately testing queueing.
VLLM_GPU_MEMORY_UTILIZATION="0.65"
VLLM_MAX_MODEL_LEN="32768"
VLLM_MAX_NUM_SEQS="4"
VLLM_MAX_NUM_BATCHED_TOKENS="8192"

# OpenAI-compatible LocalPi/tool settings. Without these, requests with
# tool_choice="auto" fail before reaching the model.
VLLM_REASONING_PARSER="qwen3"
VLLM_TOOL_CALL_PARSER="qwen3_xml"
