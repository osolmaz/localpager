#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
agent_dir="$root/localpager-agent"
schema="${LOCALPAGER_CLASSIFIER_SCHEMA:-$root/examples/profiles/openclaw-routing.schema.json}"
prompt_template="${LOCALPAGER_CLASSIFIER_PROMPT_TEMPLATE:-$root/examples/profiles/openclaw-routing.prompt.hbs}"
topic_taxonomy="${LOCALPAGER_CLASSIFIER_TOPIC_TAXONOMY:-$root/examples/profiles/openclaw-routing-topics.json}"
github_context_file="${LOCALPAGER_CLASSIFIER_GITHUB_CONTEXT_FILE:-}"

if [[ $# -lt 1 ]]; then
  echo "usage: localpager-classifier <github-url-or-owner/repo#number> [--schema <path>] [--prompt-template <path>] [--topic-taxonomy <path>] [--github-context-file <path>] [pass-through localpager-agent options]" >&2
  exit 2
fi

target="$1"
shift

expand_path() {
  case "$1" in
    "~") printf '%s\n' "${HOME:-}" ;;
    "~/"*) printf '%s/%s\n' "${HOME:-}" "${1#~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Flags the wrapper consumes itself feed the profile renderer below. Every other
# flag is forwarded verbatim to localpager-agent, which owns model selection,
# sampling, tool configuration, and the env defaults (LOCALPAGER_AGENT_*,
# LOCALPAGER_REPOSHELL_*).
require_value() {
  if [[ $# -lt 2 ]]; then
    echo "$1 requires a value" >&2
    exit 2
  fi
}

agent_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --schema)
      require_value "$@"
      schema="$2"
      shift 2
      ;;
    --prompt-template)
      require_value "$@"
      prompt_template="$2"
      shift 2
      ;;
    --topic-taxonomy)
      require_value "$@"
      topic_taxonomy="$2"
      shift 2
      ;;
    --github-context-file)
      require_value "$@"
      github_context_file="$2"
      shift 2
      ;;
    --reposhell-socket)
      require_value "$@"
      agent_args+=(--reposhell-socket "$(expand_path "$2")")
      shift 2
      ;;
    --*)
      require_value "$@"
      agent_args+=("$1" "$2")
      shift 2
      ;;
    *)
      echo "unsupported classifier argument: $1" >&2
      exit 2
      ;;
  esac
done

schema="$(expand_path "$schema")"
prompt_template="$(expand_path "$prompt_template")"
if [[ -n "$topic_taxonomy" ]]; then
  topic_taxonomy="$(expand_path "$topic_taxonomy")"
fi
if [[ -n "$github_context_file" ]]; then
  github_context_file="$(expand_path "$github_context_file")"
fi

if [[ ! -f "$prompt_template" ]]; then
  echo "missing prompt template: $prompt_template" >&2
  exit 2
fi
if [[ ! -f "$schema" ]]; then
  echo "missing classifier schema: $schema" >&2
  exit 2
fi
if [[ ! -d "$agent_dir/node_modules" ]]; then
  echo "localpager-agent dependencies are not installed; run: npm install --prefix $agent_dir" >&2
  exit 2
fi

state_dir="${LOCALPAGER_CLASSIFIER_STATE_DIR:-${HOME:-/tmp}/.local/state/localpager/classifier}"
mkdir -p "$state_dir/contexts" "$state_dir/prompts" "$state_dir/schemas" "$state_dir/sessions"
prompt_path="$state_dir/prompts/$(date -u +%Y%m%dT%H%M%SZ)-$$.md"
schema_path="$state_dir/schemas/$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
session_dir="$state_dir/sessions/$(date -u +%Y%m%dT%H%M%SZ)-$$"
if [[ -z "$github_context_file" ]]; then
  github_context_file="$state_dir/contexts/$(date -u +%Y%m%dT%H%M%SZ)-$$.md"
  localpager_bin="${LOCALPAGER_BIN:-$root/bin/localpager}"
  if [[ ! -x "$localpager_bin" ]]; then
    localpager_bin="$(command -v localpager || true)"
  fi
  if [[ -z "$localpager_bin" ]]; then
    echo "missing localpager binary; run: go build -o $root/bin/localpager ./cmd/localpager" >&2
    exit 2
  fi
  render_context_args=(
    render-context "$target"
    --output "$github_context_file"
  )
  localpager_config="${LOCALPAGER_CONFIG:-${HOME:-}/.config/localpager/config.json}"
  if [[ -n "$localpager_config" && -f "$localpager_config" ]]; then
    render_context_args+=(--config "$localpager_config")
  fi
  "$localpager_bin" "${render_context_args[@]}"
fi

render_args=(
  "$root/scripts/localpager-render-profile.mjs"
  --target "$target"
  --schema "$schema"
  --prompt-template "$prompt_template"
  --output-schema "$schema_path"
  --output-prompt "$prompt_path"
)
if [[ -n "$topic_taxonomy" ]]; then
  render_args+=(--topic-taxonomy "$topic_taxonomy")
fi
if [[ -n "$github_context_file" ]]; then
  if [[ ! -f "$github_context_file" ]]; then
    echo "missing GitHub context file: $github_context_file" >&2
    exit 2
  fi
  render_args+=(--github-context-file "$github_context_file")
fi
node "${render_args[@]}"

echo "prompt: $prompt_path" >&2
echo "schema: $schema_path" >&2
echo "session: $session_dir" >&2

# localpager-agent owns the final_json tool and its own missing-output recovery,
# so this is a single invocation: no wrapper-side retry. Invoke tsx directly
# instead of going through npm and pass the rendered prompt by file path so large
# GitHub contexts do not hit OS argument-length limits.
"$agent_dir/node_modules/.bin/tsx" "$agent_dir/src/cli/main.ts" \
  --session-dir "$session_dir" \
  --final-schema "$schema_path" \
  --prompt-template "$prompt_path" \
  --write-rendered-prompt "$prompt_path" \
  ${agent_args[@]+"${agent_args[@]}"} \
  --
