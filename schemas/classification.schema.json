{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics_of_interest", "description", "caveats"],
  "properties": {
    "topics_of_interest": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "caveats": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    }
  }
}
